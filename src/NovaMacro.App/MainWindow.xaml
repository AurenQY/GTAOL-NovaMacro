<Window x:Class="NovaMacro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NovaMacro"
        Height="780"
        Width="960"
        MinHeight="620"
        MinWidth="760"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="26" FontWeight="SemiBold" Text="NovaMacro" />
            <TextBlock Margin="0,4,0,0" Foreground="DimGray" Text="Macro editor" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,0" Padding="12" Background="#F7F7F7"
                BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <TextBlock x:Name="RuntimeStatusText" FontWeight="SemiBold" TextWrapping="Wrap" />
                <ScrollViewer x:Name="RuntimeDiagnosticsScrollViewer" MaxHeight="100" Margin="0,6,0,0"
                              VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <ItemsControl x:Name="RuntimeDiagnosticsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,2,0,0" Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <ContentControl x:Name="MultiEditorHost" Grid.Row="2" Margin="0,16,0,0" />

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="SaveButton" MinWidth="100" Padding="14,7" Click="Save_Click" Content="Save" />
            <TextBlock x:Name="SaveStatusText" Grid.Column="1" Margin="14,0,0,0"
                       VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
        </Grid>

        <TextBlock Grid.Row="4" Margin="0,14,0,0" Foreground="DimGray" TextWrapping="Wrap"
                   Text="Saved changes take effect the next time NovaMacro starts. Editing or saving does not change the current runtime." />
    </Grid>
</Window>
