<UserControl x:Class="NovaMacro.App.Editor.MultiMacroEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NovaMacro.App.Editor">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Padding="12" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Macros" />

                <Grid Grid.Row="1" Margin="0,12,0,12">
                    <ListBox ItemsSource="{Binding Macros}"
                             SelectedItem="{Binding SelectedMacro, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="DimGray" Text="{Binding HotkeyDisplay}" />
                                    <TextBlock Foreground="DimGray" Text="{Binding Enabled, StringFormat=Enabled: {0}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="DimGray"
                               Text="No macros yet.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMacros}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel x:Name="MacroActionsPanel" Grid.Row="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button MinWidth="96" Padding="8,5" Click="AddMacro_Click" Content="Add Macro" />
                        <Button x:Name="DeleteMacroButton"
                                Grid.Column="1"
                                MinWidth="96"
                                Margin="8,0,0,0"
                                Padding="8,5"
                                Click="DeleteMacro_Click"
                                Content="Delete Macro" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="PresetSelector"
                                  Padding="5,3" />
                        <Button x:Name="AddFromPresetButton"
                                Grid.Column="1"
                                MinWidth="112"
                                Margin="8,0,0,0"
                                Padding="8,5"
                                Click="AddFromPreset_Click"
                                Content="Add from preset" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Padding="16" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
                <ContentControl Content="{Binding SelectedMacro}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Name" />
                                <TextBox Grid.Column="1" Padding="7,5" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="1" Margin="0,14,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Enabled" />
                                <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" VerticalAlignment="Center" Content="Register this macro when integrated" IsChecked="{Binding Enabled, Mode=TwoWay}" />

                                <TextBlock Grid.Row="2" Margin="0,14,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Hotkey" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,14,0,0" Orientation="Horizontal">
                                    <ComboBox Width="110" Padding="5,3" ItemsSource="{Binding HotkeyKeys, RelativeSource={RelativeSource AncestorType={x:Type local:MultiMacroEditorControl}}}" SelectedItem="{Binding HotkeyKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Margin="14,0,0,0" VerticalAlignment="Center" Content="Ctrl" IsChecked="{Binding Control, Mode=TwoWay}" />
                                    <CheckBox Margin="12,0,0,0" VerticalAlignment="Center" Content="Alt" IsChecked="{Binding Alt, Mode=TwoWay}" />
                                    <CheckBox Margin="12,0,0,0" VerticalAlignment="Center" Content="Shift" IsChecked="{Binding Shift, Mode=TwoWay}" />
                                </StackPanel>

                                <Grid Grid.Row="3" Grid.ColumnSpan="2" Margin="0,18,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Macro steps" />
                                    <Border Grid.Row="1" Margin="0,8,0,8" BorderBrush="#E2E2E2" BorderThickness="1">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Steps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="7">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="32" />
                                                                <ColumnDefinition Width="82" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="58" />
                                                                <ColumnDefinition Width="58" />
                                                                <ColumnDefinition Width="68" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock VerticalAlignment="Center" Text="{Binding Position}" />
                                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding TypeLabel}" />
                                                            <Grid Grid.Column="2">
                                                                <ComboBox MinWidth="120" HorizontalAlignment="Left" Padding="5,3" ItemsSource="{Binding OutputKeys, RelativeSource={RelativeSource AncestorType={x:Type local:MultiMacroEditorControl}}}" SelectedItem="{Binding Key, Mode=TwoWay}" Visibility="{Binding IsKeyTap, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsDelay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBox Width="110" Padding="5,3" Text="{Binding MillisecondsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Foreground="DimGray" Text="ms" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <Button Grid.Column="3" Margin="0,0,4,0" Padding="5,3" Click="MoveStepUp_Click" Content="Up" IsEnabled="{Binding CanMoveUp}" Tag="{Binding}" />
                                                            <Button Grid.Column="4" Margin="0,0,4,0" Padding="5,3" Click="MoveStepDown_Click" Content="Down" IsEnabled="{Binding CanMoveDown}" Tag="{Binding}" />
                                                            <Button Grid.Column="5" Padding="5,3" Click="RemoveStep_Click" Content="Remove" Tag="{Binding}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <Button MinWidth="92" Padding="8,5" Click="AddKeyTap_Click" Content="+ Key Tap" />
                                        <Button MinWidth="82" Margin="8,0,0,0" Padding="8,5" Click="AddDelay_Click" Content="+ Delay" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Border>

            <Border Grid.Row="1" Margin="0,14,0,0" Padding="12" Background="#F7F7F7" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
                <StackPanel>
                    <TextBlock x:Name="ValidationStatusText" FontWeight="SemiBold" />
                    <ItemsControl x:Name="ValidationErrorsList" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,2,0,0" Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
